generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}
enum Status {
  PENDING
  ACTIVE
  REJECTED
}
enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}
enum TradeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}
enum TradeSide {
  OFFER
  WANT
}
enum AuctionStatus {
  ACTIVE
  ENDED
  CANCELLED
}
enum GuildRole {
  OWNER
  ADMIN
  MEMBER
}
enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(USER)
  status    Status   @default(PENDING)
  xp        Int      @default(0)
  coins     Int      @default(100)
  lastBoosterAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards          Card[]
  sentTrades     Trade[]       @relation("TradeFrom")
  receivedTrades Trade[]       @relation("TradeTo")
  bids           Bid[]
  auctions       Auction[]
  guild          GuildMember?
  messages       Message[]
  friendsFrom    Friend[]      @relation("FriendFrom")
  friendsTo      Friend[]      @relation("FriendTo")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SteamGame {
  id            String   @id
  name          String
  description   String   @db.Text
  headerImage   String
  reviewScore   Int
  peakCcu       Int
  ownerEstimate Int
  rarity        Rarity
  atk           Int
  def           Int
  tags          String[]
  developers    String[]
  updatedAt     DateTime @updatedAt

  cards    Card[]
  auctions Auction[]
}

model Studio {
  id                 String   @id @default(cuid())
  name               String   @unique
  gameCount          Int      @default(0)
  avgReviewScore     Int      @default(0)
  totalOwnerEstimate Int      @default(0)
  rarity             Rarity
  atk                Int
  def                Int
  updatedAt          DateTime @updatedAt

  cards Card[]
}

model Card {
  id        String    @id @default(cuid())
  userId    String
  gameId    String?
  studioId  String?
  createdAt DateTime  @default(now())
  isPinned  Boolean   @default(false)

  user          User       @relation(fields: [userId], references: [id])
  game          SteamGame? @relation(fields: [gameId], references: [id])
  studio        Studio?    @relation(fields: [studioId], references: [id])
  tradeCards    TradeCard[]
  auctionCard   Auction?

  @@unique([gameId])
  @@unique([studioId])
}

model Trade {
  id         String      @id @default(cuid())
  fromUserId String
  toUserId   String
  status     TradeStatus @default(PENDING)
  createdAt  DateTime    @default(now())

  fromUser User        @relation("TradeFrom", fields: [fromUserId], references: [id])
  toUser   User        @relation("TradeTo",   fields: [toUserId],   references: [id])
  cards    TradeCard[]
}

model TradeCard {
  id      String    @id @default(cuid())
  tradeId String
  cardId  String
  side    TradeSide

  trade Trade @relation(fields: [tradeId], references: [id])
  card  Card  @relation(fields: [cardId],  references: [id])
}

model Auction {
  id         String        @id @default(cuid())
  cardId     String        @unique
  sellerId   String
  gameId     String
  startPrice Int
  currentBid Int
  endsAt     DateTime
  status     AuctionStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())

  card   Card      @relation(fields: [cardId],   references: [id])
  seller User      @relation(fields: [sellerId], references: [id])
  game   SteamGame @relation(fields: [gameId],   references: [id])
  bids   Bid[]
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  userId    String
  amount    Int
  createdAt DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id])
  user    User    @relation(fields: [userId],    references: [id])
}

model Guild {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  members GuildMember[]
}

model GuildMember {
  id      String    @id @default(cuid())
  userId  String    @unique
  guildId String
  role    GuildRole @default(MEMBER)
  xp      Int       @default(0)

  user  User  @relation(fields: [userId],  references: [id])
  guild Guild @relation(fields: [guildId], references: [id])
}

model Message {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  content    String
  createdAt  DateTime @default(now())
  read       Boolean  @default(false)

  from User @relation(fields: [fromUserId], references: [id])
}

model Friend {
  id         String       @id @default(cuid())
  fromUserId String
  toUserId   String
  status     FriendStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  from User @relation("FriendFrom", fields: [fromUserId], references: [id])
  to   User @relation("FriendTo",   fields: [toUserId],   references: [id])

  @@unique([fromUserId, toUserId])
}
