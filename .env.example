# PostgreSQL (Coolify crée ces vars automatiquement si tu ajoutes un service PostgreSQL)
DATABASE_URL="postgresql://postgres:password@db:5432/steammasters"

# Redis (idem avec service Redis Coolify)
REDIS_URL="redis://redis:6379"

# NextAuth — génère avec: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="https://steammasters.obsidianspoon.com"

# App
NEXT_PUBLIC_APP_URL="https://steammasters.obsidianspoon.com"
